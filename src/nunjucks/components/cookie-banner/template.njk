{% from "govuk/components/button/macro.njk" import govukButton %}

{# Hand-written rather than govukCookieBanner so the question is a form
   that works without JavaScript; the markup matches the GOV.UK component. #}
<div class="govuk-cookie-banner" data-nosnippet role="region" aria-label="Cookies on Livestock Information" data-module="lis-cookie-banner">
  <form method="post" action="{{ params.cookiesPath }}" class="govuk-cookie-banner__message govuk-width-container" data-cookie-banner-question>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-cookie-banner__heading govuk-heading-m">Cookies on Livestock Information</h2>
        <div class="govuk-cookie-banner__content">
          <p class="govuk-body">We use some essential cookies to make this service work.</p>
          <p class="govuk-body">We’d also like to use analytics cookies so we can understand how you use the service and make improvements.</p>
        </div>
      </div>
    </div>
    <div class="govuk-button-group">
      {{ govukButton({ text: "Accept analytics cookies", type: "submit", name: "analytics", value: "yes" }) }}
      {{ govukButton({ text: "Reject analytics cookies", type: "submit", name: "analytics", value: "no" }) }}
      <a class="govuk-link" href="{{ params.cookiesPath }}">View cookies</a>
    </div>
  </form>

  <div class="govuk-cookie-banner__message govuk-width-container" role="alert" hidden data-cookie-banner-confirmation>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="govuk-cookie-banner__content">
          <p class="govuk-body">You’ve <span data-cookie-banner-decision>accepted</span> analytics cookies. You can <a class="govuk-link" href="{{ params.cookiesPath }}">change your cookie settings</a> at any time.</p>
        </div>
      </div>
    </div>
    <div class="govuk-button-group">
      {{ govukButton({ text: "Hide cookie message", type: "button", attributes: { "data-cookie-banner-hide": "" } }) }}
    </div>
  </div>
</div>
