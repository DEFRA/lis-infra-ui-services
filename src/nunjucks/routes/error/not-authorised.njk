{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Sorry, you are not authorised to view this page.</h1>
      <p class="govuk-body">Check your details are correct and try again.</p>
      <p class="govuk-body">If you think this is incorrect <a class="govuk-link" href="{{ errorPages.contactHref }}">contact our support team</a>.</p>
      {% if developmentMessage %}
        <p class="govuk-body">{{ developmentMessage }}</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
