{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if saved %}
        {% set savedHtml %}
          <h3 class="govuk-notification-banner__heading">You’ve set your cookie preferences.</h3>
          <p class="govuk-body"><a class="govuk-notification-banner__link" href="{{ returnPath }}">Go back to the page you were looking at</a></p>
        {% endset %}
        {{ govukNotificationBanner({
          type: "success",
          html: savedHtml
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">Cookies</h1>

      <p class="govuk-body">Cookies are small files saved on your phone, tablet or computer when you visit a website.</p>

      <p class="govuk-body">We use cookies to make this service work and to collect information about how you use it.</p>

      <h2 class="govuk-heading-m">Essential cookies</h2>

      <p class="govuk-body">Essential cookies keep your information secure while you use this service. We do not need to ask permission to use them.</p>

      {{ govukTable({
        firstCellIsHeader: false,
        head: [
          { text: "Name" },
          { text: "Purpose" },
          { text: "Expires" }
        ],
        rows: essentialCookieRows
      }) }}

      {% if gtmId %}
        <h2 class="govuk-heading-m">Analytics cookies (optional)</h2>

        <p class="govuk-body">With your permission, we may use analytics software to collect anonymised information about how you use this service, for example which pages you visit and how long you spend on them. This helps us improve the service.</p>

        <p class="govuk-body">We use Google Analytics to do this. If you accept analytics cookies, it sets the following cookies.</p>

        {{ govukTable({
          firstCellIsHeader: false,
          head: [
            { text: "Name" },
            { text: "Purpose" },
            { text: "Expires" }
          ],
          rows: [
            [
              { text: "_ga" },
              { text: "Checks if you have visited this service before, which helps us count how many people use it" },
              { text: "After 2 years" }
            ],
            [
              { text: "Names starting _ga_" },
              { text: "Keeps track of your visit, such as which pages you have viewed" },
              { text: "After 2 years" }
            ]
          ]
        }) }}

        <p class="govuk-body">If you choose not to accept analytics cookies, we remove any that have already been set.</p>

        <form method="post" action="{{ cookiesPath }}" novalidate>
          {{ govukRadios({
            name: "analytics",
            fieldset: {
              legend: {
                text: "Do you want to accept analytics cookies?",
                classes: "govuk-fieldset__legend--s"
              }
            },
            items: [
              { value: "yes", text: "Yes", checked: analytics },
              { value: "no", text: "No", checked: not analytics }
            ]
          }) }}

          {{ govukButton({ text: "Save cookie settings" }) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}
